# GentaNusa — Environment Variables (template)
# Copy ke .env.local dan isi nilai asli. JANGAN commit .env.local!

# Supabase — kunci koneksi (RAHASIA)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_pub_xxx
# Service role — HANYA server-side (API routes, scripts). JANGAN bocor ke client!
SUPABASE_SERVICE_KEY=sb_sec_xxx

# Admin login password (min 12 karakter, unik)
ADMIN_PASSWORD=GantiDenganPasswordKuat123!

# Email Administrator Utama GentaNusa (role 'admin' pada Supabase Auth juga
# diakui). Env ini hanya untuk override — default ada di lib/auth.ts.
MASTER_ADMIN_EMAIL=siberiantwotwo@gmail.com

# URL publik situs (dipakai robots.txt, sitemap, RSS, OpenGraph, JSON-LD)
# Set ke domain final setelah beli: https://gentanusa.id
NEXT_PUBLIC_SITE_URL=https://gentanusa.vercel.app

# 9Router API key (opsional — fallback ke Pollinations.ai bila tidak ada)
# Diisi otomatis dari ~/.hermes/.env sebagai OPENAI_API_KEY
# NINEROUTER_KEY opsional untuk image generation lokal via Flux/SDXL
# NINEROUTER_KEY=sk-xxx